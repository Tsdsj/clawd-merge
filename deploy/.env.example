# TEMPLATE ONLY. Real values belong in an ignored/private environment file.
PUBLIC_HOST=game.example.invalid
PUBLIC_ORIGIN=https://game.example.invalid
ALLOWED_ORIGINS=https://game.example.invalid
LINUXDO_CLIENT_ID=replace-with-your-client-id
CLAWD_RELEASE=local
# Optional absolute paths, configured only on the deployment host:
# CLAWD_SOURCE_DIR=
# CLAWD_DEPLOY_DIR=
# CLAWD_SITE_DIR=
# CLAWD_STATE_DIR=
# CLAWD_SECRET_DIR=
# Pin these to the verified image digests for a production release:
NODE_IMAGE=node:24.21.0-bookworm-slim
NGINX_IMAGE=nginx:stable-alpine
CERTBOT_IMAGE=certbot/certbot:latest

# Host Caddy / reverse proxy mode (run Compose from this file's directory):
# COMPOSE_FILE=compose.yaml:compose.proxied.yaml
# WEB_PROXY_PORT=8080
# Explicit -f ignores COMPOSE_FILE: always include compose.proxied.yaml as well.
# Certbot is not started in proxy mode; the host proxy owns TLS certificates.

# Keep the password overlay after accounts exist; pause only new entry points:
PASSWORD_REGISTRATION_ENABLED=0
ACCOUNT_BINDING_ENABLED=0
PASSWORD_AUTH_CONCURRENCY=2
